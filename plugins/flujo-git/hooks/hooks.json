{
  "description": "Impide hacer commits en main y comprueba que los commits siguen Conventional Commits",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/proteger-ramas.sh\""
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/proteger-ramas.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/validar-commit.sh\""
          },
          {
            "type": "command",
            "if": "PowerShell(git commit *)",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/validar-commit.sh\""
          }
        ]
      }
    ]
  }
}
